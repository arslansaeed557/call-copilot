# You do NOT need to edit this file — add keys from the Keys button in the app.
# This is here if you would rather keep them in the environment.
#
# You need one transcription key and one answers key. An OpenAI key covers both.

# --- Transcription: pick one ---
# Deepgram — free tier is $200 of credit, no card. https://console.deepgram.com
DEEPGRAM_API_KEY=
# OpenAI — also covers answers. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Answers: pick one ---
# Amazon Nova via Bedrock (or set these in the Keys dialog).
# The IAM user needs bedrock:InvokeModelWithResponseStream, and model access
# must be enabled for the model in the Bedrock console for this region.
AMAZON_NOVA_ACCESS_KEY_ID=
AMAZON_NOVA_SECRET_ACCESS_KEY=
# AMAZON_NOVA_SESSION_TOKEN=
# AMAZON_NOVA_REGION=us-east-1
# AMAZON_NOVA_MODEL=amazon.nova-lite-v1:0

# Anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ...or reuse OPENAI_API_KEY above.

# --- Optional tuning ---
# DEEPGRAM_MODEL=nova-3
# OPENAI_STT_MODEL=gpt-live-transcribe
# STT_LANGUAGE=en
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-5.6-terra
# Force a reasoning level instead of the per-detail default (low/low/medium):
# ANTHROPIC_EFFORT=low
# OPENAI_REASONING_EFFORT=low
# Opus 5 fast mode: ~2.5x output tokens/sec at premium pricing
# ANSWER_FAST_MODE=0

# Only used by `npm run web` (the desktop app picks an ephemeral port)
# PORT=5178
